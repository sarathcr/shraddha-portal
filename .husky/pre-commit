#!/bin/sh

echo "⚡ [Pre-Commit] 1/5 Running TypeScript type-check..."
npx vue-tsc --noEmit --project tsconfig.app.json || exit 1

echo "⚡ [Pre-Commit] 2/5 Running lint-staged (formatting & fix)..."
npx lint-staged || {
  echo "❌ Linting failed on staged files."
  exit 1
}

echo "⚡ [Pre-Commit] 3/5 Running ESLint check..."
npx eslint . || {
  echo "❌ ESLint check failed."
  exit 1
}

echo "⚡ [Pre-Commit] 4/5 Running Unit Tests & Coverage verification (min 80%)..."
npx vitest run --coverage || {
  echo "❌ Unit tests failed or coverage is below 80% threshold."
  exit 1
}

echo "⚡ [Pre-Commit] 5/5 Verifying Production Build..."
npx vite build || {
  echo "❌ Production build failed."
  exit 1
}

echo "✅ [Pre-Commit] All quality checks passed successfully!"

